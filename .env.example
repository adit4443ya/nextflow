# ===========================================
# NextFlow Environment Variables
# Copy this to .env.local and fill in values
# ===========================================

# --- Database (Neon PostgreSQL) ---
# Sign up at https://neon.tech, create a project, copy connection string
DATABASE_URL="postgresql://user:password@host/nextflow?sslmode=require"

# --- Clerk Authentication ---
# Sign up at https://clerk.com, create an app, get keys from dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/workflow"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/workflow"

# --- Groq (LLM inference — fast & free tier available) ---
# Get key at https://console.groq.com
GROQ_API_KEY="gsk_..."

# --- Transloadit (file uploads — browser uploads directly to their CDN) ---
# Sign up at https://transloadit.com, get keys from dashboard
NEXT_PUBLIC_TRANSLOADIT_AUTH_KEY="your_auth_key"
TRANSLOADIT_AUTH_SECRET="your_auth_secret"

# --- Trigger.dev (background tasks: LLM, crop, extract frame) ---
# Sign up at https://trigger.dev, create a project, copy keys
TRIGGER_SECRET_KEY="tr_dev_..."
NEXT_PUBLIC_TRIGGER_PUBLIC_API_KEY="pk_..."

# --- App URL (used internally for API calls) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
